# Experimental Windows PE profiles. Header targeting is not runtime certification.
set(TKGPU_LEGACY_WINDOWS_TARGET "98" CACHE STRING "Legacy Windows target: 95, 98 or xp")
set_property(CACHE TKGPU_LEGACY_WINDOWS_TARGET PROPERTY STRINGS 95 98 xp)
set(TKGPU_LEGACY_NT_HEADER 0x0400)
set(TKGPU_LEGACY_OS_MAJOR 4)
set(TKGPU_LEGACY_SUBSYSTEM_MAJOR 4)
set(TKGPU_LEGACY_SUBSYSTEM_MINOR 0)
if(TKGPU_LEGACY_WINDOWS_TARGET STREQUAL "95")
  set(TKGPU_WIN9X_HEADER 0x0400)
  set(TKGPU_LEGACY_OS_MINOR 0)
elseif(TKGPU_LEGACY_WINDOWS_TARGET STREQUAL "98")
  set(TKGPU_WIN9X_HEADER 0x0410)
  set(TKGPU_LEGACY_OS_MINOR 10)
elseif(TKGPU_LEGACY_WINDOWS_TARGET STREQUAL "xp")
  set(TKGPU_WIN9X_HEADER 0x0410)
  set(TKGPU_LEGACY_NT_HEADER 0x0501)
  set(TKGPU_LEGACY_OS_MAJOR 5)
  set(TKGPU_LEGACY_OS_MINOR 1)
  set(TKGPU_LEGACY_SUBSYSTEM_MAJOR 5)
  set(TKGPU_LEGACY_SUBSYSTEM_MINOR 1)
else()
  message(FATAL_ERROR "TKGPU_LEGACY_WINDOWS_TARGET must be 95, 98 or xp")
endif()
function(tkgpu_apply_legacy_profile target)
  if(TKGPU_LEGACY_WINDOWS_TARGET STREQUAL "xp")
    target_compile_definitions(${target} PRIVATE TKGPU_WINDOWS_XP)
  endif()
  target_compile_definitions(${target} PRIVATE TKGPU_LEGACY_WINDOWS
    WINVER=${TKGPU_LEGACY_NT_HEADER} _WIN32_WINNT=${TKGPU_LEGACY_NT_HEADER} _WIN32_WINDOWS=${TKGPU_WIN9X_HEADER})
  if(MINGW)
    get_target_property(kind ${target} TYPE)
    if(NOT kind STREQUAL "STATIC_LIBRARY")
      target_link_options(${target} PRIVATE
        "-Wl,--major-os-version,${TKGPU_LEGACY_OS_MAJOR},--minor-os-version,${TKGPU_LEGACY_OS_MINOR}"
        "-Wl,--major-subsystem-version,${TKGPU_LEGACY_SUBSYSTEM_MAJOR},--minor-subsystem-version,${TKGPU_LEGACY_SUBSYSTEM_MINOR}")
    endif()
  endif()
endfunction()
