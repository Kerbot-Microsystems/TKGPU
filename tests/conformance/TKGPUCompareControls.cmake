execute_process(COMMAND "${PREVIEW}" RESULT_VARIABLE a OUTPUT_VARIABLE actual ERROR_VARIABLE err TIMEOUT 15)
if(NOT a STREQUAL "0")
  message(FATAL_ERROR "Preview failed: ${a}: ${err}")
endif()
execute_process(COMMAND "${XVFB}" -a "${TCLSH}" "${FIXTURE}" RESULT_VARIABLE b OUTPUT_VARIABLE expected ERROR_VARIABLE err TIMEOUT 15)
