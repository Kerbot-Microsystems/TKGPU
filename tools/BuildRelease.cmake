# Run from any directory: cmake -P TKGPU/tools/BuildRelease.cmake
cmake_minimum_required(VERSION 3.20)
get_filename_component(source "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(build "${source}/build/release")
function(run)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE status)
  if(NOT status STREQUAL "0")
    message(FATAL_ERROR "Release gate failed (${status}): ${ARGV}")
  endif()
endfunction()
run("${CMAKE_COMMAND}" -S "${source}" -B "${build}" -DCMAKE_BUILD_TYPE=Release)
run("${CMAKE_COMMAND}" --build "${build}" --config Release)
run("${CMAKE_CTEST_COMMAND}" --test-dir "${build}" -C Release --output-on-failure)
message(STATUS "Local native build and unit tests passed; platform and Tcl/Tk compatibility are separate gates.")
